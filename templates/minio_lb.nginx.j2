# Managed by Ansible

upstream minio_api {
{% for ip in _minio_lb_backends %}
    server {{ ip }}:{{ minio_lb_api_port }} max_fails=3 fail_timeout=30s;
{% endfor %}
    keepalive 32;
}

upstream minio_console {
{% for ip in _minio_lb_backends %}
    server {{ ip }}:{{ minio_lb_console_port }} max_fails=3 fail_timeout=30s;
{% endfor %}
    keepalive 16;
}

# --- HTTP -> порт API (например :9000) ---
{% if (minio_lb_api_domain|default('')) %}
server {
    listen 80;
    server_name {{ minio_lb_api_domain }};
    return 308 http://$host:{{ minio_lb_api_port }}$request_uri;
}
{% endif %}

# --- HTTP -> порт Console (например :9001) ---
{% if (minio_lb_console_domain|default('')) %}
server {
    listen 80;
    server_name {{ minio_lb_console_domain }};
    return 308 http://$host:{{ minio_lb_console_port }}$request_uri;
}
{% endif %}

server {
    listen {{ minio_lb_api_listen }};
    {% if minio_lb_api_domain|default('') %}server_name {{ minio_lb_api_domain }};{% endif %}
    client_max_body_size 0;

    location / {
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_connect_timeout 300;
        proxy_read_timeout 300;
        chunked_transfer_encoding off;

        proxy_pass http://minio_api;
    }
}

server {
    listen {{ minio_lb_console_listen }};
    {% if minio_lb_console_domain|default('') %}server_name {{ minio_lb_console_domain }};{% endif %}

    location / {
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_pass http://minio_console;
    }
}
