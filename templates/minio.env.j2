MINIO_ROOT_USER={{ minio_root_user }}
MINIO_ROOT_PASSWORD={{ minio_root_password }}

{# Порты и схема #}
{% set api_port = (minio_api_port | default(minio_server_port | default(9000)) | int) %}
{% set console_port = (minio_console_port | default(minio_server_console_port | default(9001)) | int) %}
{% set api_scheme = minio_server_scheme | default(minio_scheme | default('http')) %}

MINIO_OPTS="--address :{{ api_port }} --console-address :{{ console_port }} {{ minio_server_opts | default('') }}"

{# URL’ы (если заданы) #}
{% if minio_server_url is defined and minio_server_url %}
MINIO_SERVER_URL={{ minio_server_url }}
{% endif %}

{% if minio_console_url is defined and minio_console_url %}
MINIO_BROWSER_REDIRECT_URL={{ minio_console_url }}
{% endif %}

{% if minio_region is defined and minio_region %}
MINIO_REGION_NAME={{ minio_region }}
{% endif %}

{# Определяем режим кластера #}
{% set cluster_mode = minio_cluster_mode | default('Single Instance') %}
{% set nodes_group = minio_cluster_nodes_group | default('node') %}

{# Сырые данные о дисках — как и было в старом шаблоне #}
{% set disks_raw = minio_server_datadirs
  | default(minio_extra_disks)
  | default([]) %}

{% set first_disk = disks_raw | first | default('') %}
{% if first_disk is string and first_disk %}
  {% set base_drive_path = first_disk | regex_replace('[0-9]+$', '') | regex_replace('/+$', '') %}
{% elif first_disk is mapping %}
  {% set mnt_val = first_disk.mount | default(first_disk.mountpoint) | default(first_disk.path) | default('') %}
  {% set base_drive_path = mnt_val | regex_replace('[0-9]+$', '') | regex_replace('/+$', '') %}
{% else %}
  {% set base_drive_path = '/mnt/minio/disk' %}
{% endif %}

{% if base_drive_path == '' or base_drive_path == '/' %}
  {% set base_drive_path = '/mnt/minio/disk' %}
{% endif %}

{# ============================================================
   ВЕТКА 1: одиночный инстанс — оставляем простой список путей
   ============================================================ #}
{% if cluster_mode != 'High Availability' %}

  {% set _local_vols = [] %}
  {% for d in disks_raw %}
    {% if d is string %}
      {% set mnt = d %}
    {% elif d is mapping %}
      {% set mnt = d.mount | default(d.mountpoint) | default(d.path) %}
    {% else %}
      {% set mnt = d %}
    {% endif %}
    {% set _ = _local_vols.append(mnt) %}
  {% endfor %}

  {% if _local_vols | length > 0 %}
MINIO_VOLUMES="{{ _local_vols | join(' ') }}"
  {% else %}
MINIO_VOLUMES="/var/lib/minio/data"
  {% endif %}

{# ============================================================
   ВЕТКА 2: HA-кластер, MINIO_VOLUMES через диапазоны
   ============================================================ #}
{% else %}

  {# Число нод в кластере #}
  {% if nodes_group in groups %}
    {% set cluster_hosts = (groups[nodes_group] | sort) %}
  {% else %}
    {% set cluster_hosts = (ansible_play_hosts_all | sort) %}
  {% endif %}
  {% set cluster_size = (cluster_hosts | length) | int %}

  {# Общее количество дисков на узел для «простого» случая #}
  {% set drives_per_node = (
        minio_effective_drives_per_node
        | default(disks_raw | length)
      ) | int %}
  {% set drives_per_node = 1 if drives_per_node < 1 else drives_per_node %}

  {# Если заданы пулы (после работы шага scale_out) #}
  {% if minio_pools is defined and minio_pools %}
    {% set _vol_patterns = [] %}
    {% for pool in minio_pools %}
      {% set hs = (pool.host_range[0] | int) %}
      {% set he = (pool.host_range[1] | int) %}
      {% set ds = (pool.drive_range[0] | int) %}
      {% set de = (pool.drive_range[1] | int) %}

      {% set pattern = api_scheme ~ "://minio-{" ~ hs|string ~ "..." ~ he|string ~ "}:" ~ api_port|string ~ base_drive_path ~ "{" ~ ds|string ~ "..." ~ de|string ~ "}" %}
      {% set _ = _vol_patterns.append(pattern) %}
    {% endfor %}

MINIO_VOLUMES="{{ _vol_patterns | join(' ') }}"

  {# Без minio_pools считаем, что кластер однородный: один пул,
     N нод и D дисков на ноду, имена узлов minio-1..N #}
  {% else %}

MINIO_VOLUMES="{{ api_scheme }}://minio-{1...{{ cluster_size }}}:{{ api_port }}{{ base_drive_path }}{1...{{ drives_per_node }}}"

  {% endif %}
{% endif %}

{{ minio_server_env_extra | default('') }}