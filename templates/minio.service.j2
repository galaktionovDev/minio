[Unit]
Description=MinIO Object Storage
After=network-online.target
Wants=network-online.target

[Service]
User={{ minio_user }}
Group={{ minio_group }}
EnvironmentFile={{ minio_server_envfile }}
ExecStartPre=/usr/bin/env sh -c 'grep -q "^MINIO_VOLUMES=" {{ minio_server_envfile }} || (echo "Error: MINIO_VOLUMES is not set in {{ minio_server_envfile }}"; exit 1)'
ExecStart={{ minio_bin_path | default('/usr/bin/minio') }} server $MINIO_OPTS $MINIO_VOLUMES
Restart=always
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
